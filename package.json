{
  "name": "playwright-cucumber-ai-portfolio",
  "version": "1.0.0",
  "description": "Playwright + Cucumber BDD + AI Self-Healing Test Framework",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --profile smoke",
    "test:regression": "cucumber-js --profile regression",
    "test:ci": "cucumber-js --parallel 4",
    "plan": "ts-node scripts/plan.ts",
    "generate": "ts-node scripts/generate.ts",
    "report": "node scripts/generate-report.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.7",
    "groq-sdk": "^1.1.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.1.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.10.2",
    "multiple-cucumber-html-reporter": "^3.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
