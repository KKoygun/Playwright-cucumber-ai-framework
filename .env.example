# ─── AI Provider ─────────────────────────────────────────────────────────────
# Which provider the agents use: groq (default), gemini, claude, openai, ollama
AI_PROVIDER=groq

# One key per provider — keep as many as you have and switch with AI_PROVIDER.
#   GROQ_API_KEY      free at https://console.groq.com
#   GEMINI_API_KEY    free at https://aistudio.google.com
#   ANTHROPIC_API_KEY https://console.anthropic.com (separate from a Claude.ai plan)
#   OPENAI_API_KEY    https://platform.openai.com (separate from a ChatGPT plan)
# AI_API_KEY is used for whichever provider has no key of its own above.
GROQ_API_KEY=your_groq_key_here
# OPENAI_API_KEY=your_openai_key_here

# Model to call — required, there is no default. Used exactly as written.
# Run `npm run models` to list the ones your key can use; providers retire models over time.
AI_MODEL=openai/gpt-oss-120b

# Ollama runs locally and needs no key. Default host: http://localhost:11434
# OLLAMA_HOST=http://localhost:11434

# ─── Healer ──────────────────────────────────────────────────────────────────
# suggest (default): log suggestions on failure. apply: retry the failed action with the suggestion.
# HEAL_MODE=suggest

# ─── Browser ─────────────────────────────────────────────────────────────────
# Set to "false" to run tests with a visible browser window
HEADLESS=true
