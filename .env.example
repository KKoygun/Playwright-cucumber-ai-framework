# ─── AI Provider ─────────────────────────────────────────────────────────────
# The active provider is set in src/support/world.ts (one-line swap).
# Add the key for whichever provider you want to use.

# Groq (default — free tier, no billing required)
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (free tier)
# Get your key at: https://aistudio.google.com
# GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (stub — separate API account required at console.anthropic.com)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (stub — API account required at platform.openai.com)
# OPENAI_API_KEY=your_openai_api_key_here

# ─── Browser ─────────────────────────────────────────────────────────────────
# Set to "false" to run tests with a visible browser window
HEADLESS=true
