# ─── AI Provider ─────────────────────────────────────────────────────────────
# Which provider the agents use: groq (default), gemini, claude, openai, ollama
AI_PROVIDER=groq

# Optional: override the provider's default model
# AI_MODEL=llama-3.3-70b-versatile

# Groq (free tier, no billing required) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (free tier) — https://aistudio.google.com
# GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (API account, separate from a Claude.ai plan) — https://console.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (pay-as-you-go API account, separate from ChatGPT) — https://platform.openai.com
# OPENAI_API_KEY=your_openai_api_key_here

# Ollama runs locally and needs no key. Default host: http://localhost:11434
# OLLAMA_HOST=http://localhost:11434

# ─── Healer ──────────────────────────────────────────────────────────────────
# suggest (default): log suggestions on failure. apply: retry the failed action with the suggestion.
# HEAL_MODE=suggest

# ─── Browser ─────────────────────────────────────────────────────────────────
# Set to "false" to run tests with a visible browser window
HEADLESS=true
