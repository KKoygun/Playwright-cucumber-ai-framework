# ─── AI Provider ─────────────────────────────────────────────────────────────
# Which provider the agents use: groq (default), gemini, claude, openai, ollama
AI_PROVIDER=groq

# API key for the provider above (not needed for ollama)
#   groq   — free at https://console.groq.com
#   gemini — free at https://aistudio.google.com
#   claude — https://console.anthropic.com (separate from a Claude.ai plan)
#   openai — https://platform.openai.com (separate from a ChatGPT plan)
AI_API_KEY=your_api_key_here

# Model to call — required, there is no default. Used exactly as written.
# Run `npm run models` to list the ones your key can use; providers retire models over time.
AI_MODEL=openai/gpt-oss-120b

# Ollama runs locally. Default host: http://localhost:11434
# OLLAMA_HOST=http://localhost:11434

# ─── Healer ──────────────────────────────────────────────────────────────────
# suggest (default): log suggestions on failure. apply: retry the failed action with the suggestion.
# HEAL_MODE=suggest

# ─── Browser ─────────────────────────────────────────────────────────────────
# Set to "false" to run tests with a visible browser window
HEADLESS=true
